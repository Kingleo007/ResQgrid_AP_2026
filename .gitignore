# ResQGrid — Root .gitignore

# Dependencies
node_modules/

# Environment files — NEVER commit these (contain secrets)
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Prisma generated client — regenerated by `npx prisma generate`
backend/src/generated/

# Prisma migrations (optional — commit if you want migration history)
# backend/prisma/migrations/

# Local step log
dbms/steps.md
